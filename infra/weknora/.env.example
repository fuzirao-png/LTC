# Copy to infra/weknora/.env when running WeKnora as a standalone compose project.
# In the integrated command, the repository root .env is used for LTC values.
WEKNORA_VERSION=v0.7.2
WEKNORA_CONFIG_FILE=./config/config.yaml
WEKNORA_APP_PUBLISHED_PORT=18081
WEKNORA_FRONTEND_PUBLISHED_PORT=18080

WEKNORA_DB_USER=postgres
WEKNORA_DB_PASSWORD=change-weknora-db-password
WEKNORA_DB_NAME=WeKnora
WEKNORA_REDIS_PASSWORD=change-weknora-redis-password

WEKNORA_JWT_SECRET=replace-with-a-long-random-jwt-secret
# Must be exactly 32 bytes for AES-256. Replace this placeholder before use.
WEKNORA_SYSTEM_AES_KEY=change-this-32-byte-aes-secret!!
WEKNORA_TENANT_AUTO_CREATE_API_KEY=false

# Configure embedding/LLM models in the WeKnora UI after first login.
LTC_WEKNORA_BASE_URL=http://localhost:18081
LTC_WEKNORA_API_KEY=
LTC_WEKNORA_KNOWLEDGE_BASE_IDS=
LTC_WEKNORA_TIMEOUT_SECONDS=20
