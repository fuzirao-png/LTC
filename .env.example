# Docker Compose local development only. Production secrets come from the deployment platform.
LTC_ENV=docker
LTC_COMPOSE_PROJECT_NAME=ltc-dev

# Published host ports. Container-to-container ports stay fixed.
LTC_WEB_PUBLISHED_PORT=5173
LTC_API_PUBLISHED_PORT=8000
LTC_DB_PUBLISHED_PORT=55432

# Keep the official default; teams behind a slow network may set an approved mirror.
LTC_NPM_REGISTRY=https://registry.npmjs.org

LTC_DB_NAME=ltc
LTC_DB_USER=ltc
LTC_DB_PASSWORD=ltc_local_change_me

# ---- AICodeMirror OpenAI-compatible provider ----
# Fill in the API key locally; never commit a real key.
OPENAI_BASE_URL=https://api.aicodemirror.ai/api/codex/backend-api/codex/v1
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-terra

# Shared LTC aliases used by customer analysis, meeting summary, and email.
LTC_LLM_BASE_URL=https://api.aicodemirror.ai/api/codex/backend-api/codex/v1
# LTC_LLM_API_KEY=sk-your-key-here
LTC_LLM_MODEL=gpt-5.6-terra

# ---- ASR Provider (meeting transcription) ----
# OpenAI-compatible speech-to-text endpoint
# LTC_ASR_API_KEY=sk-your-key-here
# LTC_ASR_BASE_URL=https://your-provider.example.com/v1
# LTC_ASR_MODEL=whisper-1
# LTC_ASR_TIMEOUT_SECONDS=600
# LTC_ASR_MAX_RETRIES=4
# LTC_ASR_RETRY_BASE_DELAY_SECONDS=5
# LTC_ASR_REQUEST_INTERVAL_SECONDS=2
# LTC_ASR_MAX_PARALLEL_REQUESTS=4
# LTC_ASR_TARGET_LATENCY_SECONDS=2.0
# LTC_MEDIA_JOB_CONCURRENCY=2
# LTC_AUDIO_CHUNK_SECONDS=60
# LTC_REDIS_URL=redis://127.0.0.1:6379/0
# LTC_TRACE_DECISION_WAIT=20m
# LTC_TRACE_SLOW_MS=3000

# ---- Lead Intelligence (external API keys) ----
# LEAD_ANALYSIS_LLM_API_KEY=sk-your-key-here
LEAD_ANALYSIS_LLM_BASE_URL=https://api.aicodemirror.ai/api/codex/backend-api/codex/v1
LEAD_ANALYSIS_LLM_MODEL=gpt-5.6-terra
LEAD_DISCOVERY_ROUTER_MODEL=gpt-5.6-terra
# EXA_API_KEY=your-exa-key
# APIFY_API_KEY=your-apify-key

# ---- Outbound Email (SMTP) ----
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=global.marketing@51tgt.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_SSL=true
# MAIL_FROM=global.marketing@51tgt.com

# ---- Inbound Email (IMAP) ----
# INBOUND_MAIL_ENABLED=true
# INBOUND_MAIL_HOST=imap.exmail.qq.com
# INBOUND_MAIL_PORT=993
# INBOUND_MAIL_USERNAME=global.marketing@51tgt.com
# INBOUND_MAIL_PASSWORD=your-imap-password
# INBOUND_MAIL_MAILBOX=INBOX
# INBOUND_MAIL_POLL_SECONDS=60

# IAM access token signing. Use a unique secret with at least 32 characters outside local development.
LTC_JWT_SECRET_KEY=ltc-local-development-secret-change-me
LTC_JWT_ACCESS_TOKEN_TTL_MINUTES=15
LTC_REFRESH_SESSION_TTL_DAYS=7

# Optional WeKnora read-only knowledge search.
# Integrated Compose mode: the LTC API reaches the WeKnora app by service name.
# For host/local API mode, use http://localhost:18081 instead.
LTC_WEKNORA_BASE_URL=http://weknora-app:8080
LTC_WEKNORA_API_KEY=
LTC_WEKNORA_KNOWLEDGE_BASE_IDS=
LTC_WEKNORA_TIMEOUT_SECONDS=20

# Path is relative to the first Compose file. This default is for
# `docker compose -f compose.yaml -f infra/weknora/compose.yaml ...`.
WEKNORA_CONFIG_FILE=./infra/weknora/config/config.yaml
WEKNORA_VERSION=v0.7.2
WEKNORA_FRONTEND_PUBLISHED_PORT=18080
WEKNORA_APP_PUBLISHED_PORT=18081
WEKNORA_DB_USER=postgres
WEKNORA_DB_PASSWORD=change-weknora-db-password
WEKNORA_DB_NAME=WeKnora
WEKNORA_REDIS_PASSWORD=change-weknora-redis-password
WEKNORA_JWT_SECRET=replace-with-a-long-random-jwt-secret
WEKNORA_SYSTEM_AES_KEY=change-this-32-byte-aes-secret!!
WEKNORA_TENANT_AUTO_CREATE_API_KEY=false

# Customer-operation email attachments
LTC_MAIL_ATTACHMENT_DIR=.local-data/email-attachments
LTC_MAIL_ATTACHMENT_MAX_FILE_BYTES=20971520
LTC_MAIL_ATTACHMENT_MAX_MESSAGE_BYTES=52428800
